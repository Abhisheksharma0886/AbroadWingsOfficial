# ─── Server Configuration ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Rate Limiting ──────────────────────────────────────────────────────────
# Max enquiry submissions per IP per window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=900000

# ─── Database ───────────────────────────────────────────────────────────────
DB_PATH=./db/future_abroad.sqlite

# ─── SMTP Email (Optional) ──────────────────────────────────────────────────
# If left empty, email delivery is disabled and enquiries are stored only in DB.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Consultancy owner email — receives new enquiry notifications
ADMIN_EMAIL=

# Reply-to / from address for student acknowledgement emails
FROM_EMAIL=

# ─── Contact Info (Displayed in Footer / Legal Pages) ───────────────────────
CONTACT_EMAIL=hello@abroadwingsofficial.netlify.app
CONTACT_WHATSAPP=+91XXXXXXXXXX
CONTACT_CITY=Jharkhand, India
SITE_URL=https://abroadwingsofficial.netlify.app
NEXT_PUBLIC_SITE_URL=https://abroadwingsofficial.netlify.app
